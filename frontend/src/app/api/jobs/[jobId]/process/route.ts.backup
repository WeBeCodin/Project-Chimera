/**
 * Job Processing Endpoint (Database with Mock Fallback)
 * POST /api/jobs/[jobId]/process - Process video job
 */

import { NextRequest, NextResponse } from 'next/server';
import { db, processingJobs } from '@/lib/db';
import { eq } from 'drizzle-orm';

export const runtime = 'nodejs';

interface RouteContext {
  params: {
    jobId: string;
  };
}

// Mock processing delays (in ms)
const PROCESSING_DELAYS = {
  start: 2000,       // 2 seconds to start
  transcribe: 5000,  // 5 seconds for transcription
  analyze: 3000,     // 3 seconds for analysis
  summarize: 3000    // 3 seconds for summarization
};

export async function POST(
  request: NextRequest,
  { params }: RouteContext
) {
  try {
    const { jobId } = params;

    // Check if DATABASE_URL is configured
    if (!process.env.DATABASE_URL) {
      // Use mock store
      const { mockJobStore } = await import('@/lib/mock-job-store');
      const job = mockJobStore.get(jobId);

      if (!job) {
        return NextResponse.json(
          { error: 'Job not found' },
          { status: 404 }
        );
      }

      processJobAsync(jobId, true);

      return NextResponse.json({
        success: true,
        message: 'Processing started',
        jobId,
        status: 'RUNNING',
        source: 'mock'
      });
    }

    // Use database
    const [job] = await db
      .select()
      .from(processingJobs)
      .where(eq(processingJobs.id, jobId))
      .limit(1);

    if (!job) {
      return NextResponse.json(
        { error: 'Job not found' },
        { status: 404 }
      );
    }

    processJobAsync(jobId, false);

    return NextResponse.json({
      success: true,
      message: 'Processing started',
      jobId,
      status: 'processing',
      source: 'database'
    });
  } catch (error) {
    console.error('Error starting job processing:', error);
    return NextResponse.json(
      { error: 'Failed to start processing' },
      { status: 500 }
    );
  }
}

// Process job with real AI or mock
async function processJobAsync(jobId: string, useMock: boolean) {
  const startTime = Date.now();
  
  try {
    // Update to RUNNING
    if (useMock) {
      const { mockJobStore } = await import('@/lib/mock-job-store');
      mockJobStore.update(jobId, {
        status: 'RUNNING',
        startedAt: new Date().toISOString()
      });
    } else {
      await db
        .update(processingJobs)
        .set({
          status: 'processing',
          startedAt: new Date()
        })
        .where(eq(processingJobs.id, jobId));
    }

    // Check if AI keys are configured
    const hasAIKeys = process.env.GROQ_API_KEY || process.env.GOOGLE_GENERATIVE_AI_API_KEY;
    
    let results;
    
    if (!useMock && hasAIKeys) {
      // Use real AI processing
      console.log(`[Job ${jobId}] Starting real AI processing...`);
      
      // Get job details to find video URL
      let videoUrl = 'https://example.com/video.mp4'; // Fallback
      
      const [job] = await db
        .select()
        .from(processingJobs)
        .where(eq(processingJobs.id, jobId))
        .limit(1);
      
      if (job?.inputData && typeof job.inputData === 'object' && 'url' in job.inputData) {
        videoUrl = (job.inputData as { url: string }).url;
      }
      
      try {
        const { processVideo } = await import('@/lib/video-processing');
        const result = await processVideo(videoUrl);
        
        results = {
          transcription: result.transcription,
          detection: result.detection,
          summarization: result.summarization
        };
        
        console.log(`[Job ${jobId}] Real AI processing completed in ${Date.now() - startTime}ms`);
      } catch (error) {
        console.error(`[Job ${jobId}] AI processing error:`, error);
        // Fall back to mock on error
        results = getMockResults();
      }
    } else {
      // Use mock processing with delays
      console.log(`[Job ${jobId}] Using mock processing (AI keys not configured or mock mode)`);
      await new Promise(resolve => setTimeout(resolve, PROCESSING_DELAYS.start));
      await new Promise(resolve => setTimeout(resolve, PROCESSING_DELAYS.transcribe));
      await new Promise(resolve => setTimeout(resolve, PROCESSING_DELAYS.analyze));
      await new Promise(resolve => setTimeout(resolve, PROCESSING_DELAYS.summarize));
      
      results = getMockResults();
    }

    // Mark as completed
    if (useMock) {
      const { mockJobStore } = await import('@/lib/mock-job-store');
      mockJobStore.update(jobId, {
        status: 'COMPLETED',
        completedAt: new Date().toISOString(),
        result: results
      });
    } else {
      await db
        .update(processingJobs)
        .set({
          status: 'completed',
          completedAt: new Date(),
          outputData: results,
          durationMs: Date.now() - startTime
        })
        .where(eq(processingJobs.id, jobId));
    }

    console.log(`Job ${jobId} completed successfully (${useMock ? 'mock' : 'database'}, ${hasAIKeys ? 'AI' : 'mock data'})`);
  } catch (error) {
    console.error(`Job ${jobId} failed:`, error);
    
    if (useMock) {
      const { mockJobStore } = await import('@/lib/mock-job-store');
      mockJobStore.update(jobId, {
        status: 'FAILED',
        completedAt: new Date().toISOString()
      });
    } else {
      await db
        .update(processingJobs)
        .set({
          status: 'failed',
          completedAt: new Date(),
          errorMessage: error instanceof Error ? error.message : 'Unknown error'
        })
        .where(eq(processingJobs.id, jobId));
    }
  }
}

// Generate mock results
function getMockResults() {
  return {
      transcription: {
        text: "Welcome to Project Chimera, a comprehensive video processing platform. This demo showcases our AI-powered transcription capabilities. The system can accurately transcribe spoken content, identify speakers, and timestamp every word for precise editing.",
        confidence: 0.94,
        duration: 45.2,
        segments: [
          {
            text: "Welcome to Project Chimera",
            start: 0,
            end: 2.5,
            confidence: 0.96
          },
          {
            text: "a comprehensive video processing platform",
            start: 2.5,
            end: 5.8,
            confidence: 0.95
          },
          {
            text: "This demo showcases our AI-powered transcription capabilities",
            start: 6.0,
            end: 10.5,
            confidence: 0.93
          }
        ]
      },
      detection: {
        objects: [
          { name: 'person', confidence: 0.98, count: 2 },
          { name: 'laptop', confidence: 0.87, count: 1 },
          { name: 'desk', confidence: 0.92, count: 1 }
        ],
        scenes: [
          {
            startTime: 0,
            endTime: 15,
            description: 'Office workspace with natural lighting',
            confidence: 0.91
          },
          {
            startTime: 15,
            endTime: 30,
            description: 'Close-up of computer screen showing interface',
            confidence: 0.89
          },
          {
            startTime: 30,
            endTime: 45,
            description: 'Wide shot of presenter at desk',
            confidence: 0.94
          }
        ],
        faces: [
          {
            id: 'face_1',
            confidence: 0.96,
            appearances: 12,
            emotions: { neutral: 0.6, happy: 0.3, focused: 0.1 }
          }
        ]
      },
      summarization: {
        summary: "This video introduces Project Chimera, an advanced video processing platform that leverages AI for transcription, object detection, and content analysis. The platform demonstrates real-time processing capabilities and comprehensive video understanding features.",
        keyPoints: [
          "AI-powered transcription with high accuracy",
          "Real-time object and scene detection",
          "Automated video content analysis",
          "User-friendly interface for video editing"
        ],
        sentiment: 'positive',
        topics: ['technology', 'AI', 'video processing', 'automation'],
        duration: 45,
        language: 'en'
      }
    };

    // Mark as completed
    if (useMock) {
      const { mockJobStore } = await import('@/lib/mock-job-store');
      mockJobStore.update(jobId, {
        status: 'COMPLETED',
        completedAt: new Date().toISOString(),
        result: mockResults
      });
    } else {
      await db
        .update(processingJobs)
        .set({
          status: 'completed',
          completedAt: new Date(),
          outputData: mockResults
        })
        .where(eq(processingJobs.id, jobId));
    }

    console.log(`Job ${jobId} completed successfully (${useMock ? 'mock' : 'database'})`);
  } catch (error) {
    console.error(`Job ${jobId} failed:`, error);
    
    if (useMock) {
      const { mockJobStore } = await import('@/lib/mock-job-store');
      mockJobStore.update(jobId, {
        status: 'FAILED',
        completedAt: new Date().toISOString()
      });
    } else {
      await db
        .update(processingJobs)
        .set({
          status: 'failed',
          completedAt: new Date(),
          errorMessage: error instanceof Error ? error.message : 'Unknown error'
        })
        .where(eq(processingJobs.id, jobId));
    }
  }
}
